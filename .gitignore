# ═══════════════════════════════════════
# DATA INSIGHT — .gitignore
# ═══════════════════════════════════════

# ─── Environment Variables (NEVER COMMIT) ───────────────────
.env
.env.local
.env.*.local
backend/.env

# ─── Python ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
venv/
.venv/
env/
.tox/
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/
*.log

# ─── Node.js / Next.js ──────────────────────────────────────
node_modules/
.next/
out/
.vercel
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Docker ─────────────────────────────────────────────────
*.dockerignore

# ─── IDE ────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ─── OS ─────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# ─── Logs ───────────────────────────────────────────────────
logs/
*.log

# ─── Uploads / Generated Files ──────────────────────────────
uploads/
generated/
temp/

# ─── Celery & Runtime ─────────────────────────────────────────
celerybeat-schedule*
backend/celerybeat-schedule*
.refact/

# ─── Alembic ─────────────────────────────────────────────────
# Keep migrations but ignore generated caches
backend/app/db/migrations/__pycache__/

