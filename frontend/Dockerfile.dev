FROM node:20-alpine

WORKDIR /app

# Copy package files first to leverage Docker layer cache
COPY package.json package-lock.json ./

# Install all dependencies
RUN npm install

# Remove any stale/corrupted .next cache before starting.
# This prevents the "Network Error" login issue that occurs when the cache
# gets corrupted from a previous dev session or package update.
CMD ["sh", "-c", "rm -rf /app/.next && npm run dev"]
